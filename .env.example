# PostgreSQL used by the web app and migrations
DATABASE_URL=postgresql://transcriptly:transcriptly@localhost:5432/transcriptly

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Exact chrome-extension:// origins allowed to call auth endpoints,
# comma-separated. The extension ID is stable via the manifest key in
# apps/extension/wxt.config.ts.
EXTENSION_ORIGINS=chrome-extension://nieojpobkpchdjmijgdgnnllkggijbdh
