{
  "name": "transcriptly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:web": "pnpm --filter @transcriptly/web dev",
    "db:generate": "pnpm --filter @transcriptly/web db:generate",
    "db:migrate": "pnpm --filter @transcriptly/web db:migrate",
    "cloud:up": "docker compose up --build -d",
    "cloud:down": "docker compose down",
    "e2e": "pnpm --filter @transcriptly/extension run build && pnpm --filter @transcriptly/extension run e2e",
    "e2e:web": "pnpm --filter @transcriptly/web run e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  }
}
